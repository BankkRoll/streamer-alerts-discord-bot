{
  "name": "streamer-alerts-bot",
  "version": "3.0.0",
  "description": "Discord bot for multi-platform streamer live alerts, built on Components V2",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "discord",
    "bot",
    "streaming",
    "twitch",
    "kick",
    "youtube",
    "rumble",
    "tiktok",
    "alerts",
    "components-v2"
  ],
  "license": "MIT"
}
