# ---------------------------------------------------------------------------
# Streamer Alerts Bot — environment configuration
#
# Only DISCORD_TOKEN and CLIENT_ID are required. Everything else has a working
# default, so copy this file to .env, fill in the two required values, and run.
#
# Every variable is validated at startup. A bad value fails immediately with a
# message naming the problem rather than misbehaving later.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=

# Application ID (General Information -> Application ID).
CLIENT_ID=

# --- Command deployment -----------------------------------------------------

# Deploy slash commands to a single guild for instant availability while
# developing. Leave empty to deploy globally, which can take up to an hour to
# propagate. Used by `npm run deploy`.
# GUILD_ID=

# --- Storage ----------------------------------------------------------------

# Which backend persists guild data.
#   json   (default) a local file; needs no extra packages
#   memory            nothing is persisted; useful for tests
#   keyv              any Keyv backend; requires `npm install keyv` plus an
#                     adapter such as @keyv/sqlite
# STORAGE_DRIVER=json

# Directory for the json driver's data file and its backup.
# STORAGE_PATH=./data

# Delay before batching pending writes to disk, in milliseconds. Coalesces the
# burst of updates one poll cycle produces into a single write.
# STORAGE_WRITE_DEBOUNCE_MS=250

# Required only when STORAGE_DRIVER=keyv.
# STORAGE_CONNECTION_STRING=sqlite://data/bot.sqlite

# --- Polling ----------------------------------------------------------------

# Gap between poll cycles, in milliseconds. Lower values detect streams sooner
# at the cost of more requests to each platform.
# POLL_INTERVAL_MS=60000

# Abort an individual platform request after this long, in milliseconds.
# REQUEST_TIMEOUT_MS=10000

# Retry attempts for a failed platform request, excluding the first try.
# Applies only to network errors, 429, and 5xx responses.
# REQUEST_MAX_RETRIES=2

# How many streamers are checked simultaneously within one cycle.
# POLL_CONCURRENCY=5

# Suppress a repeat alert for the same streamer within this window, in
# milliseconds. Stops a flapping platform from spamming a channel.
# ALERT_COOLDOWN_MS=1800000

# Consecutive failed checks before a streamer is reported as unhealthy.
# POLL_FAILURE_THRESHOLD=5

# --- Interface --------------------------------------------------------------

# Streamers shown per page in /streamer list. Clamped to whatever Discord's
# 40-component message budget allows, so raising this beyond the cap has no
# effect.
# ITEMS_PER_PAGE=5

# How long list and confirmation components stay interactive, in milliseconds.
# INTERACTION_TIMEOUT_MS=300000

# Default per-user command cooldown, in milliseconds. Individual commands may
# declare a longer one.
# DEFAULT_COOLDOWN_MS=3000

# --- Limits -----------------------------------------------------------------

# Maximum streamers one guild may track.
# MAX_STREAMERS_PER_GUILD=100

# --- Runtime ----------------------------------------------------------------

# Minimum severity that reaches the log output.
# One of: debug, info, warn, error, silent
# LOG_LEVEL=info

# Emit machine-readable JSON lines instead of human-formatted output. Set this
# when shipping logs to an aggregator.
# LOG_JSON=false

# Show the tracked-streamer count as the bot's activity status.
# PRESENCE_ENABLED=true

# How often the presence string refreshes, in milliseconds.
# PRESENCE_INTERVAL_MS=300000
